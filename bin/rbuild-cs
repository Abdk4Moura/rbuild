#!/usr/bin/env bash
# rbuild-cs: the reserve Codespace (or a persistent ssh host) for interactive Rust work.
#
# Codespaces hours are metered, so the default build path is `rbuild` (free
# Actions runner). This is for what Actions cannot do: a tight edit/compile
# loop, debugging a failing test, poking at a live binary. It reuses ONE
# existing Codespace (never creates one), keeps the source repo cloned on its
# disk so builds stay incremental, and always hands you a `down`.
#
#   rbuild cs status               # backend, state, disk, toolchain, checkout
#   rbuild cs up [--no-prewarm]    # start, clone/refresh, ensure stable toolchain, warm the page cache
#   rbuild cs build [--ref R] [-- cargo args]        # up + cargo build --release
#   rbuild cs fetch [--out DIR]    # copy the binary back
#   rbuild cs run [--ref R] [--out DIR] [-- args]    # up + build + fetch + down
#   rbuild cs sync                 # rsync the working tree over (uncommitted ok)
#   rbuild cs dev [--check] [--fetch] [-- cargo args]   # THE LOOP: sync + incremental dev build/check, timed
#   rbuild cs session 2h | status | end   # keep the box warm for a bounded time (heartbeat), then stop
#   rbuild cs sh [cmd...]          # interactive shell, or one command
#   rbuild cs clean                # remove target/ dirs on the codespace
#   rbuild cs down                 # stop it (ALWAYS, when done)
#
# CS and CS_DIR come from .rbuild or RBUILD_CS / RBUILD_CS_DIR. The idle
# timeout (30 min) cannot be changed on an existing codespace (the API
# accepts idle_timeout_minutes and keeps 30); it is the safety net, `down`
# is the rule, and `session` holds it with a heartbeat for a bounded time.
#
# Backends: CS_SSH=user@host (usually in ~/.config/rbuild/config, with
# CS_SSH_PROXY / CS_SSH_KEY / CS_SSH_PORT) points every verb at a persistent
# host over plain ssh, checkout in ~/rbuild/<repo>; `gh` is not used then.
# RBUILD_BACKEND=codespace ignores CS_SSH for one invocation, =ssh forces it.

set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=rbuild-lib.sh
. "$HERE/rbuild-lib.sh"

main() {

REF=""; OUT=""; EXTRA=()
usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
VERB="${1:-status}"; shift || true
while [ $# -gt 0 ]; do
  case "$1" in
    --ref) REF="$2"; shift 2 ;;
    --out) OUT="$2"; shift 2 ;;
    -h|--help) usage 0 ;;
    --) shift; EXTRA=("$@"); break ;;
    *) EXTRA+=("$1"); shift ;;
  esac
done
rb_load_config
[ -n "$CS" ] || { echo "rbuild-cs: no codespace configured (CS= in .rbuild or RBUILD_CS), and no CS_SSH host" >&2; exit 2; }
REPO_URL="https://github.com/$SRC_REPO.git"
[ -n "$OUT" ] || OUT="${XDG_CACHE_HOME:-$HOME/.cache}/rbuild/${SRC_REPO/\//-}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/rbuild"

# One ssh config per codespace, with connection multiplexing: the first
# connection opens the gh tunnel (several seconds of handshake), later rsync
# and command calls ride the same socket for ~10 minutes. This is what makes
# an edit/dev iteration cost seconds instead of two handshakes.
# With BACKEND=ssh the same file describes the persistent host (CS_SSH,
# CS_SSH_PROXY, CS_SSH_KEY, CS_SSH_PORT) and nothing below touches `gh`.
ssh_cfg() {
  local cfg="$CACHE_DIR/cs-$CS.ssh"
  mkdir -p "$CACHE_DIR"
  if [ "$BACKEND" = ssh ]; then
    {
      printf 'Host rbuild-%s\n  HostName %s\n  User %s\n  Port %s\n  IdentityFile %s\n  IdentitiesOnly yes\n  StrictHostKeyChecking accept-new\n' \
        "${CS#ssh-}" "${CS_SSH#*@}" "${CS_SSH%%@*}" "$CS_SSH_PORT" "$CS_SSH_KEY"
      [ -n "$CS_SSH_PROXY" ] && printf '  ProxyCommand %s\n' "$CS_SSH_PROXY"
      printf '  ControlMaster auto\n  ControlPath %s/rbuild-cs-%%C\n  ControlPersist 10m\n  ServerAliveInterval 30\n  LogLevel ERROR\n' "${TMPDIR:-/tmp}"
    } > "$cfg.tmp"; mv "$cfg.tmp" "$cfg"
  elif [ ! -s "$cfg" ] || [ -n "$(find "$cfg" -mmin +60 2>/dev/null)" ]; then
    gh codespace ssh -c "$CS" --config > "$cfg.tmp" 2>/dev/null || { rm -f "$cfg.tmp"; return 1; }
    printf '  ControlMaster auto\n  ControlPath %s/rbuild-cs-%%C\n  ControlPersist 10m\n  ServerAliveInterval 30\n  LogLevel ERROR\n' "${TMPDIR:-/tmp}" >> "$cfg.tmp"
    mv "$cfg.tmp" "$cfg"
  fi
  printf '%s' "$cfg"
}
ssh_host() { awk '/^Host /{print $2; exit}' "$1"; }

# The ssh backend's default CS_DIR is ~/rbuild/<repo>; remote scripts quote
# it, so resolve `~` to the remote $HOME once (cached next to the ssh config).
resolve_cs_dir() {
  [ "$BACKEND" = ssh ] || return 0
  case "$CS_DIR" in '~'|'~/'*) ;; *) return 0 ;; esac
  local f="$CACHE_DIR/cs-$CS.home" home cfg
  if [ -s "$f" ]; then home="$(cat "$f")"; else
    cfg="$(ssh_cfg)"; home="$(ssh -F "$cfg" "$(ssh_host "$cfg")" 'echo "$HOME"' 2>/dev/null | tail -1)"
    [ -n "$home" ] || { echo "rbuild-cs: cannot reach $CS_SSH to resolve CS_DIR ($CS_DIR)" >&2; return 1; }
    printf '%s' "$home" > "$f"
  fi
  CS_DIR="$home${CS_DIR#\~}"
}

# Copy one remote file here. rsync over the multiplexed tunnel compresses and
# sends only changed blocks against the previous copy (a rebuilt binary is
# mostly identical), so a 100 MB debug binary refreshes in seconds; base64
# streaming is the fallback when rsync is missing on either side.
fetch_file() {
  local src="$1" dst="$2" cfg host want got; cfg="$(ssh_cfg)" || return 1; host="$(ssh_host "$cfg")"
  # Never a silent 0-byte file: check the remote file exists first, and
  # compare sha256 after the copy (a broken transfer must fail loudly).
  want="$(ssh -F "$cfg" "$host" "sha256sum '$src' 2>/dev/null | cut -d' ' -f1")"
  [ -n "$want" ] || { echo "rbuild-cs: remote file not found: $src" >&2; return 1; }
  if command -v rsync >/dev/null 2>&1; then rsync -az --inplace -e "ssh -F $cfg" "$host:$src" "$dst" 2>/dev/null \
    || ssh -F "$cfg" "$host" "base64 -w0 '$src'" 2>/dev/null | tr -d '\r\n' | base64 -d > "$dst"
  else ssh -F "$cfg" "$host" "base64 -w0 '$src'" 2>/dev/null | tr -d '\r\n' | base64 -d > "$dst"; fi
  got="$(sha256sum "$dst" 2>/dev/null | cut -d' ' -f1)"
  [ "$want" = "$got" ] || { echo "rbuild-cs: fetch of $src corrupt (remote ${want:0:12} local ${got:0:12})" >&2; rm -f "$dst"; return 1; }
}

LEASE_DIR="$CACHE_DIR"
lease_file() { printf '%s/cs-%s.lease' "$LEASE_DIR" "$CS"; }
lease_log()  { printf '%s/cs-%s.session.log' "$LEASE_DIR" "$CS"; }

# Read the whole target dir into the page cache in the background, right
# after a wake. On the codespace (16 GB RAM, ~5 GB target) the first build
# after a resume then behaves like any other (150 s -> ~10 s measured), and
# it runs while you are still typing. Detached on the remote, so this
# returns at once. `up --no-prewarm` skips it (a small-RAM host, say).
prewarm() {
  remote "${CS_TARGET_DIR:+export CARGO_TARGET_DIR='$CS_TARGET_DIR';} cd '$CS_DIR/$MANIFEST_DIR' 2>/dev/null || exit 0
    [ -d target ] || exit 0
    # The login profile leaves a dup of the ssh stderr pipe on a high fd
    # (fd 6 seen), and any child that inherits it keeps sshd waiting until
    # the child exits: redirecting 0-2 was not enough, the session hung for
    # the whole cat. Close every fd above 2 before detaching.
    for fd in \$(ls /proc/\$\$/fd); do [ \"\$fd\" -gt 2 ] && eval \"exec \$fd>&-\"; done
    setsid nohup sh -c 'find target -type f -print0 2>/dev/null | xargs -0 cat >/dev/null 2>&1' </dev/null >/dev/null 2>&1 &
    echo \"rbuild-cs: prewarming \$(du -sh target 2>/dev/null | cut -f1) of target/ into RAM (background)\""
}

# The session lease: keep the box awake for a bounded time so every dev
# iteration inside it is warm, then stop it. The idle timeout (30 min, not
# changeable on an existing codespace) counts connections as activity, so a
# heartbeat over the multiplexed tunnel every few minutes holds it. If the
# box stops anyway the holder says so in the log and wakes it again.
session_holder() {  # runs detached: session_holder <end_epoch>
  local end="$1" cfg host st
  while [ "$(date +%s)" -lt "$end" ]; do
    st="$(state)"
    if [ "$st" != "Available" ] && [ "${BACKEND}" = codespace ]; then
      echo "$(date -u +%FT%TZ) box is $st during lease; waking it" >> "$(lease_log)"
      ensure_up >/dev/null 2>&1 && prewarm >/dev/null 2>&1
    fi
    cfg="$(ssh_cfg 2>/dev/null)" && host="$(ssh_host "$cfg")" && ssh -F "$cfg" -o ConnectTimeout=20 "$host" true >/dev/null 2>&1 \
      && echo "$(date -u +%FT%TZ) heartbeat ok ($(( (end - $(date +%s)) / 60 )) min left)" >> "$(lease_log)" \
      || echo "$(date -u +%FT%TZ) heartbeat FAILED (state $(state))" >> "$(lease_log)"
    sleep 240
  done
  echo "$(date -u +%FT%TZ) lease ended, stopping" >> "$(lease_log)"
  rm -f "$(lease_file)"
  cmd_down >> "$(lease_log)" 2>&1
}

parse_duration() {  # 90m, 2h, 45 -> seconds
  case "$1" in
    *h) echo $(( ${1%h} * 3600 )) ;; *m) echo $(( ${1%m} * 60 )) ;; *s) echo "${1%s}" ;;
    ''|*[!0-9]*) return 1 ;; *) echo $(( $1 * 60 )) ;;
  esac
}

cmd_session() {
  mkdir -p "$LEASE_DIR"
  local sub="${EXTRA[0]:-}"
  case "$sub" in
    ''|status)
      if [ -s "$(lease_file)" ]; then
        read -r pid end < "$(lease_file)"
        if kill -0 "$pid" 2>/dev/null; then
          echo "rbuild-cs: lease active, $(( (end - $(date +%s)) / 60 )) min left (holder pid $pid, box $(state))"
          tail -3 "$(lease_log)" 2>/dev/null | sed 's/^/  /'
        else echo "rbuild-cs: stale lease file (holder gone); box $(state)"; rm -f "$(lease_file)"; fi
      else echo "rbuild-cs: no lease; box $(state). Start one: rbuild cs session 2h"; fi ;;
    end|stop)
      if [ -s "$(lease_file)" ]; then read -r pid _ < "$(lease_file)"; kill "$pid" 2>/dev/null; rm -f "$(lease_file)"; echo "rbuild-cs: lease ended"; fi
      cmd_down ;;
    *)
      local secs; secs="$(parse_duration "$sub")" || { echo "rbuild-cs: session <duration: 90m | 2h> | status | end" >&2; return 2; }
      if [ -s "$(lease_file)" ]; then read -r pid _ < "$(lease_file)"; kill "$pid" 2>/dev/null; fi
      EXTRA=(); cmd_up
      local end=$(( $(date +%s) + secs ))
      ( session_holder "$end" ) >/dev/null 2>&1 &
      disown
      echo "$! $end" > "$(lease_file)"
      echo "$(date -u +%FT%TZ) lease started for $sub" >> "$(lease_log)"
      echo "rbuild-cs: lease for $sub; the box stays warm until $(date -u -d "@$end" +%H:%M) UTC, then stops. 'rbuild cs session' shows status, 'rbuild cs session end' stops now." ;;
  esac
}

# Run a script on the codespace. gh starts a stopped codespace implicitly.
# The script travels base64-encoded as ONE argument, so quoting and newlines
# never reach the remote shell's argv (the naive multi-line `bash -lc "..."`
# form trips "bash: -c: option requires an argument"). ~/.cargo/env is sourced
# because the codespace login PATH does not include ~/.cargo/bin.
remote() {
  local b64 out rc try
  b64="$(printf '%s\n' '. "$HOME/.cargo/env" 2>/dev/null || true' "$1" | base64 -w0)"
  # Right after a resume the codespace reports Available before its ssh
  # server answers ("context deadline exceeded", "timed out while waiting");
  # retry those a few times before giving up.
  # A codespace that is still ShuttingDown cannot be started; gh just times
  # out. Wait for it to settle first (common right after `down`).
  ensure_up || return 1
  for try in 1 2 3 4 5 6; do
    local cfg; cfg="$(ssh_cfg)" || cfg=""
    rc=0
    if [ -n "$cfg" ]; then
      out="$(ssh -F "$cfg" "$(ssh_host "$cfg")" "echo $b64 | base64 -d | bash -ls" 2>&1)" || rc=$?
    elif [ "$BACKEND" = codespace ]; then
      out="$(gh codespace ssh -c "$CS" -- "echo $b64 | base64 -d | bash -ls" 2>&1)" || rc=$?
    else
      echo "rbuild-cs: no ssh config for $CS_SSH" >&2; return 1
    fi
    if [ $rc -ne 0 ] && printf '%s' "$out" | grep -qiE 'error connecting|context deadline exceeded|timed out while waiting|error getting ssh server'; then
      echo "rbuild-cs: codespace not answering yet (try $try/6), waiting 15s" >&2; sleep 15; continue
    fi
    break
  done
  # `|| true`: an all-noise output makes grep exit 1, and under set -e that
  # took the caller down (seen when prewarm had nothing to say on a fresh host).
  printf '%s\n' "$out" | grep -v '^#\+ *[0-9.]*%\|No default node version\|use .nvs link\|^Now using node v\|^$' || true
  return $rc
}
state() {
  [ "$BACKEND" = ssh ] && { echo Available; return; }
  gh codespace view -c "$CS" --json state --jq .state 2>/dev/null || echo unknown
}
# Bring the codespace to Available before any ssh/rsync: a box that is still
# ShuttingDown cannot be started (gh just times out), and starting explicitly
# via the API is faster and more reliable than letting ssh trigger it.
ensure_up() {
  [ "$BACKEND" = ssh ] && return 0
  local st; for _ in $(seq 1 24); do st="$(state)"; [ "$st" = "ShuttingDown" ] || break; sleep 5; done
  if [ "$(state)" = "Shutdown" ]; then gh api -X POST "/user/codespaces/$CS/start" >/dev/null 2>&1 || true; fi
  for _ in $(seq 1 36); do [ "$(state)" = "Available" ] && return 0; sleep 5; done
  echo "rbuild-cs: codespace did not reach Available (state $(state))" >&2; return 1
}

# Where the checkouts live on the remote: /workspaces on a codespace, the
# parent of CS_DIR over ssh. Status, clean and the free-space figure use it.
work_root() { if [ "$BACKEND" = ssh ]; then printf '%s' "${CS_DIR%/*}"; else printf /workspaces; fi; }

cmd_status() {
  if [ "$BACKEND" = ssh ]; then
    echo "backend: ssh  host: $CS_SSH${CS_SSH_PORT:+ port $CS_SSH_PORT}${CS_SSH_PROXY:+  via: $CS_SSH_PROXY}"
    echo "key: $CS_SSH_KEY  dir: $CS_DIR"
  else
    echo "backend: codespace"; gh codespace view -c "$CS"
  fi
  if [ "$(state)" = "Available" ]; then
    echo "--- remote"
    remote "
      mkdir -p '$(work_root)' 2>/dev/null; df -h '$(work_root)' | tail -1 | awk '{print \"disk: \"\$3\" used / \"\$2\" (\"\$5\"), \"\$4\" free\"}'
      for t in '$(work_root)'/*/target '$(work_root)'/*/*/target; do [ -d \"\$t\" ] && echo \"target: \$(du -sh \"\$t\" | cut -f1) \$t\"; done
      if [ -d '$CS_DIR/.git' ]; then cd '$CS_DIR' && echo \"checkout: \$(git rev-parse --abbrev-ref HEAD) \$(git rev-parse --short HEAD)\"; else echo 'checkout: none'; fi
      command -v cargo >/dev/null && (cd '$CS_DIR' 2>/dev/null || cd /; echo \"cargo: \$(cargo --version)\") || echo 'cargo: MISSING'
      command -v mold >/dev/null && echo \"linker: mold\" || echo 'linker: default (no mold)'
      echo \"cores: \$(nproc)  mem: \$(free -m | awk '/^Mem/{print \$7\" MB available of \"\$2}')\""
  else
    echo "(stopped: 'rbuild cs up' to start)"
  fi
}

cmd_up() {
  if [ "$BACKEND" = ssh ]; then echo "rbuild-cs: preparing $CS_SSH:$CS_DIR"; else echo "rbuild-cs: starting $CS (state: $(state))"; fi
  local t0; t0=$(date +%s)
  remote "
    set -e
    if ! command -v rustup >/dev/null 2>&1; then
      echo 'rbuild-cs: installing rustup'
      curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable >/dev/null
      . \"\$HOME/.cargo/env\"
    fi
    if [ ! -d '$CS_DIR/.git' ]; then echo 'rbuild-cs: cloning $SRC_REPO into $CS_DIR'; mkdir -p '$(work_root)'; git clone -q '$REPO_URL' '$CS_DIR'; fi
    cd '$CS_DIR' && git fetch -q origin
    # Fast linker by default (user-level config, the repo's own
    # .cargo/config.toml is left alone). Relinking dominated the old loop.
    # Needs root to install; a host without passwordless sudo just skips it.
    if ! command -v mold >/dev/null 2>&1; then
      if sudo -n true 2>/dev/null; then sudo apt-get install -y -q mold >/dev/null 2>&1 && echo 'rbuild-cs: installed mold'
      else echo 'rbuild-cs: mold: skipped (no passwordless sudo)'; fi
    fi
    if command -v mold >/dev/null 2>&1 && ! grep -qs 'fuse-ld=mold' \"\$HOME/.cargo/config.toml\"; then
      mkdir -p \"\$HOME/.cargo\"; printf '\n[target.x86_64-unknown-linux-gnu]\nrustflags = [\"-C\", \"link-arg=-fuse-ld=mold\"]\n' >> \"\$HOME/.cargo/config.toml\"
      echo 'rbuild-cs: mold set as linker in ~/.cargo/config.toml'
    fi
    # Smaller dev/test artifacts: full debuginfo made one crate tree 8 GB on
    # the 32 GB disk (test binaries 300 MB each). Line tables keep file:line
    # in backtraces at a fraction of the size. User-level, applies to every
    # cargo invocation on the box, including `rbuild cs sh 'cargo test'`.
    if ! grep -qs 'profile.dev' \"\$HOME/.cargo/config.toml\"; then
      printf '\n# rbuild: smaller dev/test artifacts; backtraces keep file:line\n[profile.dev]\ndebug = \"line-tables-only\"\n[profile.test]\ndebug = \"line-tables-only\"\n' >> \"\$HOME/.cargo/config.toml\"
      echo 'rbuild-cs: dev/test debuginfo set to line-tables-only in ~/.cargo/config.toml'
    fi
    # Stable unless the project pins its own toolchain.
    if [ ! -f rust-toolchain ] && [ ! -f rust-toolchain.toml ] && [ ! -f '$MANIFEST_DIR/rust-toolchain' ] && [ ! -f '$MANIFEST_DIR/rust-toolchain.toml' ]; then
      rustup toolchain list | grep -q '^stable' || rustup toolchain install stable --profile minimal >/dev/null
      # A stable that predates the last ~4 months is a leftover install
      # (popos had 1.77 from 2024); refresh it rather than fail on MSRV.
      d=\$(rustc +stable --version 2>/dev/null | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' || echo 1970-01-01)
      if [ \$(( (\$(date +%s) - \$(date -d \"\$d\" +%s)) / 86400 )) -gt 120 ]; then
        echo \"rbuild-cs: stable is from \$d, running rustup update stable\"; rustup update stable --no-self-update 2>&1 | grep -E 'installed|updated|unchanged' | head -1
      fi
      rustup override list 2>/dev/null | grep -q \"^$CS_DIR\" || rustup override set stable >/dev/null
    fi
    # Shared R2 compile cache, if the codespace carries the R2_* user secrets.
    if [ -n \"\${R2_ACCESS_KEY_ID:-}\" ] && [ -n \"\${R2_ACCOUNT_ID:-}\" ]; then
      if ! command -v sccache >/dev/null 2>&1; then
        echo 'rbuild-cs: installing sccache'
        curl -sL https://github.com/mozilla/sccache/releases/download/v0.10.0/sccache-v0.10.0-x86_64-unknown-linux-musl.tar.gz \\
          | tar -xz --strip-components=1 -C \"\$HOME/.cargo/bin\" --wildcards '*/sccache'
      fi
      echo 'rbuild-cs: compile cache: R2 (shared)'
    else
      echo 'rbuild-cs: compile cache: local only ($([ "$BACKEND" = ssh ] && echo "export R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ACCOUNT_ID in the remote login profile" || echo "set Codespaces user secrets R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ACCOUNT_ID") to share)'
    fi
    echo \"rbuild-cs: ready  \$(cargo --version)  \$(nproc) cores  \$(df -h '$(work_root)' | tail -1 | awk '{print \$4}') free\""
  echo "rbuild-cs: up in $(( $(date +%s) - t0 ))s"
  case " ${EXTRA[*]:-} " in *" --no-prewarm "*) ;; *) prewarm ;; esac
}

cmd_build() {
  cmd_up
  [ -n "$REF" ] || REF="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
  echo "rbuild-cs: building $SRC_REPO@$REF: cargo build --release $FEATURES ${EXTRA[*]:-}"; local t0; t0=$(date +%s)
  remote "
    set -e
    cd '$CS_DIR' && git fetch -q origin '$REF' && git checkout -q --detach FETCH_HEAD
    echo \"rbuild-cs: at \$(git rev-parse --short HEAD)\"
    export FILAMENT_BUILD_SHA=\$(git rev-parse --short HEAD) FILAMENT_BUILD_DATE=\$(date -u +%F) RBUILD_SHA=\$(git rev-parse --short HEAD)
    if [ -n \"\${R2_ACCESS_KEY_ID:-}\" ] && command -v sccache >/dev/null 2>&1; then
      export RUSTC_WRAPPER=sccache SCCACHE_BUCKET=\"\${R2_BUCKET:-sccache}\" SCCACHE_REGION=auto SCCACHE_S3_USE_SSL=true \\
             SCCACHE_ENDPOINT=\"https://\$R2_ACCOUNT_ID.r2.cloudflarestorage.com\" SCCACHE_S3_KEY_PREFIX='$SRC_REPO/' \\
             AWS_ACCESS_KEY_ID=\"\$R2_ACCESS_KEY_ID\" AWS_SECRET_ACCESS_KEY=\"\$R2_SECRET_ACCESS_KEY\" CARGO_INCREMENTAL=0
      # A rejected token must not take the build down with it.
      if ! sccache --start-server >/tmp/sccache-start.log 2>&1; then
        echo \"rbuild-cs: R2 cache unreachable (\$(grep -m1 -oE 'S3Error.{0,80}|error.{0,80}' /tmp/sccache-start.log | head -1)); building without a shared cache\"
        unset RUSTC_WRAPPER
      fi
    fi
    ${CS_TARGET_DIR:+export CARGO_TARGET_DIR='$CS_TARGET_DIR';} cd '$MANIFEST_DIR' && cargo build --release $FEATURES ${EXTRA[*]:-}
    # Record where cargo put the binary (a global build.target or target-dir
    # relocates it); this no-op rebuild only checks freshness.
    cargo build --release $FEATURES ${EXTRA[*]:-} --message-format=json-render-diagnostics 2>/dev/null \\
      | jq -r 'select(.reason==\"compiler-artifact\" and .executable!=null) | .executable' | tail -1 > '$CS_DIR/.rbuild-last-bin'
    echo \"rbuild-cs: binary at \$(cat '$CS_DIR/.rbuild-last-bin')\"
    command -v sccache >/dev/null 2>&1 && [ -n \"\${RUSTC_WRAPPER:-}\" ] && sccache --show-stats | grep -E 'hits|misses|Cache location' | head -4 || true"
  echo "rbuild-cs: build took $(( $(date +%s) - t0 ))s"
}

cmd_fetch() {
  mkdir -p "$OUT"
  # Ask cargo where target/ is: a CARGO_TARGET_DIR in the codespace's profile
  # or a .cargo/config.toml relocates it, and guessing failed once already.
  local src; src="$(remote "
    if [ -s '$CS_DIR/.rbuild-last-bin' ]; then cat '$CS_DIR/.rbuild-last-bin'; else
      ${CS_TARGET_DIR:+export CARGO_TARGET_DIR='$CS_TARGET_DIR';} cd '$CS_DIR/$MANIFEST_DIR' && cargo build --release $FEATURES --message-format=json-render-diagnostics 2>/dev/null \\
        | jq -r 'select(.reason==\"compiler-artifact\" and .executable!=null) | .executable' | tail -1
    fi" | tail -1)"
  [ -n "$src" ] || { echo "rbuild-cs: could not locate the built binary on the codespace (run 'rbuild cs build' first)" >&2; return 1; }
  # Stream over the ssh channel rather than `gh codespace cp`: on this box the
  # cp/scp path fails with "No such file or directory" even for /etc/hostname.
  # base64 keeps it tty-safe; sha256 on both ends proves the bytes arrived.
  local want got
  want="$(remote "sha256sum '$src' | cut -d' ' -f1" | tail -1)"
  fetch_file "$src" "$OUT/$BIN.part"
  got="$(sha256sum "$OUT/$BIN.part" | cut -d' ' -f1)"
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    echo "rbuild-cs: checksum mismatch fetching $src (remote ${want:0:12} local ${got:0:12})" >&2; rm -f "$OUT/$BIN.part"; return 1
  fi
  mv "$OUT/$BIN.part" "$OUT/$BIN"; chmod +x "$OUT/$BIN"
  echo "rbuild-cs: binary -> $OUT/$BIN  (from $src, sha256 ${got:0:12})"
}

cmd_sync() {
  rb_need rsync
  ensure_up || return 1
  local cfg host ex=(); cfg="$(ssh_cfg)" || { echo "rbuild-cs: cannot get ssh config for $CS" >&2; return 1; }
  host="$(ssh_host "$cfg")"
  IFS=',' read -ra _ex <<< "$SYNC_EXCLUDE"; for e in "${_ex[@]}"; do e="$(echo "$e" | tr -d '[:space:]')"; [ -n "$e" ] && ex+=(--exclude "$e"); done
  # Ownership guard. rsync --delete makes the remote dir a mirror of ONE local
  # tree; a second agent syncing its own tree into the same CS_DIR silently
  # deletes the first agent's files (2026-09-13: a checkout without the exec
  # branch overwrote the worker's). The dir remembers its source; a different
  # source is refused unless RBUILD_TAKE_OVER=1.
  local me="$(hostname):$ROOT" owner
  owner="$(ssh -F "$cfg" "$host" "cat '$CS_DIR/.rbuild-source' 2>/dev/null" 2>/dev/null || true)"
  if [ -n "$owner" ] && [ "$owner" != "$me" ] && [ "${RBUILD_TAKE_OVER:-0}" != 1 ]; then
    echo "rbuild-cs: REFUSED: $CS_DIR on the box mirrors $owner, not $me." >&2
    echo "           Use your own dir (RBUILD_CS_DIR=/workspaces/<repo>-<you>) or RBUILD_TAKE_OVER=1 to claim it." >&2
    return 3
  fi
  echo "rbuild-cs: rsync $ROOT/ -> $host:$CS_DIR/ ${SYNC_EXCLUDE:+(excluding $SYNC_EXCLUDE)}"
  local err; err="$(rsync -az --delete -e "ssh -F $cfg" --exclude .git --exclude target --exclude node_modules --exclude .rbuild-source "${ex[@]}" "$ROOT/" "$host:$CS_DIR/" 2>&1 >/dev/null)" || {
    local rc=$?; printf '%s\n' "$err" >&2
    # rsync needs a silent non-interactive login shell on the remote; a
    # profile that prints (nvm's "Now using node ..." from a fish config,
    # say) breaks its handshake with exactly this message.
    if printf '%s' "$err" | grep -q 'protocol version mismatch'; then
      echo "rbuild-cs: the remote login shell prints on startup, which breaks rsync. Guard the noisy line (nvm, motd...) with an interactive check in the remote shell config, e.g. fish: 'if status is-interactive ... end'. Output seen:" >&2
      ssh -F "$cfg" "$host" true 2>&1 | head -3 | sed 's/^/  | /' >&2
    fi
    return $rc; }
  ssh -F "$cfg" "$host" "printf '%s' '$me' > '$CS_DIR/.rbuild-source'" 2>/dev/null || true
}

# The inner loop: rsync the working tree over (uncommitted edits included),
# then an incremental dev build (or --check) on the warm target dir. Prints
# the seconds so a slow step is visible, and fetches the binary with --fetch.
cmd_dev() {
  local mode="build" fetch=false args=()
  for a in "${EXTRA[@]}"; do case "$a" in --check) mode="check" ;; --fetch) fetch=true ;; *) args+=("$a") ;; esac; done
  local t0; t0=$(date +%s)
  EXTRA=(); cmd_sync
  local t1; t1=$(date +%s)
  remote "
    ${CS_TARGET_DIR:+export CARGO_TARGET_DIR='$CS_TARGET_DIR';} cd '$CS_DIR/$MANIFEST_DIR' && s=\$SECONDS
    cargo $mode --profile dev ${args[*]:-} 2>&1 | grep -vE '^\s*(Compiling|Checking|Downloaded|Downloading|Updating|Blocking)' | tail -40
    echo \"rbuild-cs: cargo $mode \$((SECONDS-s)) s\""
  echo "rbuild-cs: sync $((t1 - t0)) s, total $(( $(date +%s) - t0 )) s"
  if [ "$fetch" = true ] && [ "$mode" = build ]; then
    OUT="$OUT" EXTRA=()
    # Ask cargo where the dev binary is: with CS_TARGET_DIR (shared target) it
    # is not under CS_DIR, and guessing produced a silent 0-byte fetch once.
    local src; src="$(remote "${CS_TARGET_DIR:+export CARGO_TARGET_DIR='$CS_TARGET_DIR';} cd '$CS_DIR/$MANIFEST_DIR' && cargo build --profile dev ${args[*]:-} --message-format=json-render-diagnostics 2>/dev/null | jq -r 'select(.reason==\"compiler-artifact\" and .executable!=null) | .executable' | tail -1" | tail -1)"
    [ -n "$src" ] || { echo "rbuild-cs: cargo did not report an executable to fetch" >&2; return 1; }
    mkdir -p "$OUT"; local t2; t2=$(date +%s); fetch_file "$src" "$OUT/$BIN.dev" && chmod +x "$OUT/$BIN.dev" && echo "rbuild-cs: dev binary -> $OUT/$BIN.dev ($(du -h "$OUT/$BIN.dev" | cut -f1), fetch $(( $(date +%s) - t2 )) s)"
  fi
}

cmd_clean() {
  remote "
    for d in '$(work_root)'/*/target '$(work_root)'/*/*/target; do
      [ -d \"\$d\" ] && { echo \"rbuild-cs: removing \$(du -sh \"\$d\" | cut -f1) \$d\"; rm -rf \"\$d\"; }
    done; df -h '$(work_root)' | tail -1 | awk '{print \"rbuild-cs: \"\$4\" free\"}'"
}

cmd_down() {
  if [ -s "$(lease_file)" ] && [ "${IN_HOLDER:-0}" = 0 ]; then read -r pid _ < "$(lease_file)"; kill "$pid" 2>/dev/null; rm -f "$(lease_file)"; echo "rbuild-cs: lease ended"; fi
  if [ "$BACKEND" = ssh ]; then echo "rbuild-cs: $CS_SSH is a persistent host, nothing to stop"; return; fi
  if [ "$(state)" = "Shutdown" ]; then echo "rbuild-cs: already stopped"; return; fi
  gh codespace stop -c "$CS"; echo "rbuild-cs: stopped $CS"
}

case "$VERB" in down|-h|--help|help) ;; *) resolve_cs_dir || exit 1 ;; esac
case "$VERB" in
  status) cmd_status ;;
  up)     cmd_up ;;
  build)  cmd_build ;;
  fetch)  cmd_fetch ;;
  run)    trap 'cmd_down' EXIT; cmd_build; cmd_fetch ;;
  sync)   cmd_sync ;;
  dev)    cmd_dev ;;
  session) cmd_session ;;
  sh)     if [ ${#EXTRA[@]} -gt 0 ]; then remote "${EXTRA[*]}"
          elif [ "$BACKEND" = ssh ]; then cfg="$(ssh_cfg)" && ssh -F "$cfg" "$(ssh_host "$cfg")"
          else ensure_up && gh codespace ssh -c "$CS"; fi ;;
  clean)  cmd_clean ;;
  down)   cmd_down ;;
  -h|--help|help) usage 0 ;;
  *) echo "rbuild-cs: unknown verb $VERB" >&2; usage 2 ;;
esac
}

# exit here so bash never reads past this line: the file may have been
# edited while this process ran, and stale bytes would parse as garbage.
main "$@"; exit $?
