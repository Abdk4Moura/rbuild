#!/usr/bin/env bash
# rbuild-cs: the reserve Codespace for interactive Rust work.
#
# Codespaces hours are metered, so the default build path is `rbuild` (free
# Actions runner). This is for what Actions cannot do: a tight edit/compile
# loop, debugging a failing test, poking at a live binary. It reuses ONE
# existing Codespace (never creates one), keeps the source repo cloned on its
# disk so builds stay incremental, and always hands you a `down`.
#
#   rbuild cs status               # state, disk, toolchain, checkout
#   rbuild cs up                   # start, clone/refresh, ensure stable toolchain
#   rbuild cs build [--ref R] [-- cargo args]        # up + cargo build --release
#   rbuild cs fetch [--out DIR]    # copy the binary back
#   rbuild cs run [--ref R] [--out DIR] [-- args]    # up + build + fetch + down
#   rbuild cs sync                 # rsync the working tree over (uncommitted ok)
#   rbuild cs dev [--check] [--fetch] [-- cargo args]   # THE LOOP: sync + incremental dev build/check, timed
#   rbuild cs sh [cmd...]          # interactive shell, or one command
#   rbuild cs clean                # remove target/ dirs on the codespace
#   rbuild cs down                 # stop it (ALWAYS, when done)
#
# CS and CS_DIR come from .rbuild or RBUILD_CS / RBUILD_CS_DIR. The idle
# timeout (30 min) cannot be changed with gh; it is the safety net, `down` is
# the rule.

set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=rbuild-lib.sh
. "$HERE/rbuild-lib.sh"

main() {

REF=""; OUT=""; EXTRA=()
usage() { sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
VERB="${1:-status}"; shift || true
while [ $# -gt 0 ]; do
  case "$1" in
    --ref) REF="$2"; shift 2 ;;
    --out) OUT="$2"; shift 2 ;;
    -h|--help) usage 0 ;;
    --) shift; EXTRA=("$@"); break ;;
    *) EXTRA+=("$1"); shift ;;
  esac
done
rb_load_config
[ -n "$CS" ] || { echo "rbuild-cs: no codespace configured (CS= in .rbuild or RBUILD_CS)" >&2; exit 2; }
REPO_URL="https://github.com/$SRC_REPO.git"
[ -n "$OUT" ] || OUT="${XDG_CACHE_HOME:-$HOME/.cache}/rbuild/${SRC_REPO/\//-}"

# One ssh config per codespace, with connection multiplexing: the first
# connection opens the gh tunnel (several seconds of handshake), later rsync
# and command calls ride the same socket for ~10 minutes. This is what makes
# an edit/dev iteration cost seconds instead of two handshakes.
ssh_cfg() {
  local cfg="${XDG_CACHE_HOME:-$HOME/.cache}/rbuild/cs-$CS.ssh"
  if [ ! -s "$cfg" ] || [ -n "$(find "$cfg" -mmin +60 2>/dev/null)" ]; then
    mkdir -p "$(dirname "$cfg")"
    gh codespace ssh -c "$CS" --config > "$cfg.tmp" 2>/dev/null || { rm -f "$cfg.tmp"; return 1; }
    printf '  ControlMaster auto\n  ControlPath %s/rbuild-cs-%%C\n  ControlPersist 10m\n  ServerAliveInterval 30\n  LogLevel ERROR\n' "${TMPDIR:-/tmp}" >> "$cfg.tmp"
    mv "$cfg.tmp" "$cfg"
  fi
  printf '%s' "$cfg"
}
ssh_host() { awk '/^Host /{print $2; exit}' "$1"; }

# Run a script on the codespace. gh starts a stopped codespace implicitly.
# The script travels base64-encoded as ONE argument, so quoting and newlines
# never reach the remote shell's argv (the naive multi-line `bash -lc "..."`
# form trips "bash: -c: option requires an argument"). ~/.cargo/env is sourced
# because the codespace login PATH does not include ~/.cargo/bin.
remote() {
  local b64 out rc try
  b64="$(printf '%s\n' '. "$HOME/.cargo/env" 2>/dev/null || true' "$1" | base64 -w0)"
  # Right after a resume the codespace reports Available before its ssh
  # server answers ("context deadline exceeded", "timed out while waiting");
  # retry those a few times before giving up.
  # A codespace that is still ShuttingDown cannot be started; gh just times
  # out. Wait for it to settle first (common right after `down`).
  ensure_up || return 1
  for try in 1 2 3 4 5 6; do
    local cfg; cfg="$(ssh_cfg)" || cfg=""
    if [ -n "$cfg" ]; then
      out="$(ssh -F "$cfg" "$(ssh_host "$cfg")" "echo $b64 | base64 -d | bash -ls" 2>&1)"; rc=$?
    else
      out="$(gh codespace ssh -c "$CS" -- "echo $b64 | base64 -d | bash -ls" 2>&1)"; rc=$?
    fi
    if [ $rc -ne 0 ] && printf '%s' "$out" | grep -qiE 'error connecting|context deadline exceeded|timed out while waiting|error getting ssh server'; then
      echo "rbuild-cs: codespace not answering yet (try $try/6), waiting 15s" >&2; sleep 15; continue
    fi
    break
  done
  printf '%s\n' "$out" | grep -v '^#\+ *[0-9.]*%\|No default node version\|use .nvs link\|^$'
  return $rc
}
state() { gh codespace view -c "$CS" --json state --jq .state 2>/dev/null || echo unknown; }
# Bring the codespace to Available before any ssh/rsync: a box that is still
# ShuttingDown cannot be started (gh just times out), and starting explicitly
# via the API is faster and more reliable than letting ssh trigger it.
ensure_up() {
  local st; for _ in $(seq 1 24); do st="$(state)"; [ "$st" = "ShuttingDown" ] || break; sleep 5; done
  if [ "$(state)" = "Shutdown" ]; then gh api -X POST "/user/codespaces/$CS/start" >/dev/null 2>&1 || true; fi
  for _ in $(seq 1 36); do [ "$(state)" = "Available" ] && return 0; sleep 5; done
  echo "rbuild-cs: codespace did not reach Available (state $(state))" >&2; return 1
}

cmd_status() {
  gh codespace view -c "$CS"
  if [ "$(state)" = "Available" ]; then
    echo "--- remote"
    remote "
      df -h /workspaces | tail -1 | awk '{print \"disk: \"\$3\" used / \"\$2\" (\"\$5\"), \"\$4\" free\"}'
      for t in /workspaces/*/target /workspaces/*/*/target; do [ -d \"\$t\" ] && echo \"target: \$(du -sh \"\$t\" | cut -f1) \$t\"; done
      if [ -d '$CS_DIR/.git' ]; then cd '$CS_DIR' && echo \"checkout: \$(git rev-parse --abbrev-ref HEAD) \$(git rev-parse --short HEAD)\"; else echo 'checkout: none'; fi
      command -v cargo >/dev/null && (cd '$CS_DIR' 2>/dev/null || cd /; echo \"cargo: \$(cargo --version)\") || echo 'cargo: MISSING'
      echo \"cores: \$(nproc)\""
  else
    echo "(stopped: 'rbuild cs up' to start)"
  fi
}

cmd_up() {
  echo "rbuild-cs: starting $CS (state: $(state))"; local t0; t0=$(date +%s)
  remote "
    set -e
    if ! command -v rustup >/dev/null 2>&1; then
      echo 'rbuild-cs: installing rustup'
      curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable >/dev/null
      . \"\$HOME/.cargo/env\"
    fi
    if [ ! -d '$CS_DIR/.git' ]; then echo 'rbuild-cs: cloning $SRC_REPO'; git clone -q '$REPO_URL' '$CS_DIR'; fi
    cd '$CS_DIR' && git fetch -q origin
    # Fast linker by default on the codespace (user-level config, the repo's
    # own .cargo/config.toml is left alone). Relinking dominated the old loop.
    if ! command -v mold >/dev/null 2>&1; then sudo apt-get install -y -q mold >/dev/null 2>&1 && echo 'rbuild-cs: installed mold'; fi
    if command -v mold >/dev/null 2>&1 && ! grep -qs 'fuse-ld=mold' \"\$HOME/.cargo/config.toml\"; then
      mkdir -p \"\$HOME/.cargo\"; printf '\n[target.x86_64-unknown-linux-gnu]\nrustflags = [\"-C\", \"link-arg=-fuse-ld=mold\"]\n' >> \"\$HOME/.cargo/config.toml\"
      echo 'rbuild-cs: mold set as linker in ~/.cargo/config.toml'
    fi
    # Stable unless the project pins its own toolchain.
    if [ ! -f rust-toolchain ] && [ ! -f rust-toolchain.toml ] && [ ! -f '$MANIFEST_DIR/rust-toolchain' ] && [ ! -f '$MANIFEST_DIR/rust-toolchain.toml' ]; then
      rustup toolchain list | grep -q '^stable' || rustup toolchain install stable --profile minimal >/dev/null
      rustup override list 2>/dev/null | grep -q \"^$CS_DIR\" || rustup override set stable >/dev/null
    fi
    # Shared R2 compile cache, if the codespace carries the R2_* user secrets.
    if [ -n \"\${R2_ACCESS_KEY_ID:-}\" ] && [ -n \"\${R2_ACCOUNT_ID:-}\" ]; then
      if ! command -v sccache >/dev/null 2>&1; then
        echo 'rbuild-cs: installing sccache'
        curl -sL https://github.com/mozilla/sccache/releases/download/v0.10.0/sccache-v0.10.0-x86_64-unknown-linux-musl.tar.gz \\
          | tar -xz --strip-components=1 -C \"\$HOME/.cargo/bin\" --wildcards '*/sccache'
      fi
      echo 'rbuild-cs: compile cache: R2 (shared)'
    else
      echo 'rbuild-cs: compile cache: local only (set Codespaces user secrets R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ACCOUNT_ID to share)'
    fi
    echo \"rbuild-cs: ready  \$(cargo --version)  \$(nproc) cores  \$(df -h /workspaces | tail -1 | awk '{print \$4}') free\""
  echo "rbuild-cs: up in $(( $(date +%s) - t0 ))s"
}

cmd_build() {
  cmd_up
  [ -n "$REF" ] || REF="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
  echo "rbuild-cs: building $SRC_REPO@$REF: cargo build --release $FEATURES ${EXTRA[*]:-}"; local t0; t0=$(date +%s)
  remote "
    set -e
    cd '$CS_DIR' && git fetch -q origin '$REF' && git checkout -q --detach FETCH_HEAD
    echo \"rbuild-cs: at \$(git rev-parse --short HEAD)\"
    export FILAMENT_BUILD_SHA=\$(git rev-parse --short HEAD) FILAMENT_BUILD_DATE=\$(date -u +%F) RBUILD_SHA=\$(git rev-parse --short HEAD)
    if [ -n \"\${R2_ACCESS_KEY_ID:-}\" ] && command -v sccache >/dev/null 2>&1; then
      export RUSTC_WRAPPER=sccache SCCACHE_BUCKET=\"\${R2_BUCKET:-sccache}\" SCCACHE_REGION=auto SCCACHE_S3_USE_SSL=true \\
             SCCACHE_ENDPOINT=\"https://\$R2_ACCOUNT_ID.r2.cloudflarestorage.com\" SCCACHE_S3_KEY_PREFIX='$SRC_REPO/' \\
             AWS_ACCESS_KEY_ID=\"\$R2_ACCESS_KEY_ID\" AWS_SECRET_ACCESS_KEY=\"\$R2_SECRET_ACCESS_KEY\" CARGO_INCREMENTAL=0
      # A rejected token must not take the build down with it.
      if ! sccache --start-server >/tmp/sccache-start.log 2>&1; then
        echo \"rbuild-cs: R2 cache unreachable (\$(grep -m1 -oE 'S3Error.{0,80}|error.{0,80}' /tmp/sccache-start.log | head -1)); building without a shared cache\"
        unset RUSTC_WRAPPER
      fi
    fi
    cd '$MANIFEST_DIR' && cargo build --release $FEATURES ${EXTRA[*]:-}
    # Record where cargo put the binary (a global build.target or target-dir
    # relocates it); this no-op rebuild only checks freshness.
    cargo build --release $FEATURES ${EXTRA[*]:-} --message-format=json-render-diagnostics 2>/dev/null \\
      | jq -r 'select(.reason==\"compiler-artifact\" and .executable!=null) | .executable' | tail -1 > '$CS_DIR/.rbuild-last-bin'
    echo \"rbuild-cs: binary at \$(cat '$CS_DIR/.rbuild-last-bin')\"
    command -v sccache >/dev/null 2>&1 && [ -n \"\${RUSTC_WRAPPER:-}\" ] && sccache --show-stats | grep -E 'hits|misses|Cache location' | head -4 || true"
  echo "rbuild-cs: build took $(( $(date +%s) - t0 ))s"
}

cmd_fetch() {
  mkdir -p "$OUT"
  # Ask cargo where target/ is: a CARGO_TARGET_DIR in the codespace's profile
  # or a .cargo/config.toml relocates it, and guessing failed once already.
  local src; src="$(remote "
    if [ -s '$CS_DIR/.rbuild-last-bin' ]; then cat '$CS_DIR/.rbuild-last-bin'; else
      cd '$CS_DIR/$MANIFEST_DIR' && cargo build --release $FEATURES --message-format=json-render-diagnostics 2>/dev/null \\
        | jq -r 'select(.reason==\"compiler-artifact\" and .executable!=null) | .executable' | tail -1
    fi" | tail -1)"
  [ -n "$src" ] || { echo "rbuild-cs: could not locate the built binary on the codespace (run 'rbuild cs build' first)" >&2; return 1; }
  # Stream over the ssh channel rather than `gh codespace cp`: on this box the
  # cp/scp path fails with "No such file or directory" even for /etc/hostname.
  # base64 keeps it tty-safe; sha256 on both ends proves the bytes arrived.
  local want got
  want="$(remote "sha256sum '$src' | cut -d' ' -f1" | tail -1)"
  local cfg; cfg="$(ssh_cfg)"; ssh -F "$cfg" "$(ssh_host "$cfg")" "base64 -w0 '$src'" 2>/dev/null | tr -d '\r\n' | base64 -d > "$OUT/$BIN.part"
  got="$(sha256sum "$OUT/$BIN.part" | cut -d' ' -f1)"
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    echo "rbuild-cs: checksum mismatch fetching $src (remote ${want:0:12} local ${got:0:12})" >&2; rm -f "$OUT/$BIN.part"; return 1
  fi
  mv "$OUT/$BIN.part" "$OUT/$BIN"; chmod +x "$OUT/$BIN"
  echo "rbuild-cs: binary -> $OUT/$BIN  (from $src, sha256 ${got:0:12})"
}

cmd_sync() {
  rb_need rsync
  ensure_up || return 1
  local cfg host ex=(); cfg="$(ssh_cfg)" || { echo "rbuild-cs: cannot get ssh config for $CS" >&2; return 1; }
  host="$(ssh_host "$cfg")"
  IFS=',' read -ra _ex <<< "$SYNC_EXCLUDE"; for e in "${_ex[@]}"; do e="$(echo "$e" | tr -d '[:space:]')"; [ -n "$e" ] && ex+=(--exclude "$e"); done
  echo "rbuild-cs: rsync $ROOT/ -> $host:$CS_DIR/ ${SYNC_EXCLUDE:+(excluding $SYNC_EXCLUDE)}"
  rsync -az --delete -e "ssh -F $cfg" --exclude .git --exclude target --exclude node_modules "${ex[@]}" "$ROOT/" "$host:$CS_DIR/"
}

# The inner loop: rsync the working tree over (uncommitted edits included),
# then an incremental dev build (or --check) on the warm target dir. Prints
# the seconds so a slow step is visible, and fetches the binary with --fetch.
cmd_dev() {
  local mode="build" fetch=false args=()
  for a in "${EXTRA[@]}"; do case "$a" in --check) mode="check" ;; --fetch) fetch=true ;; *) args+=("$a") ;; esac; done
  local t0; t0=$(date +%s)
  EXTRA=(); cmd_sync
  local t1; t1=$(date +%s)
  remote "
    cd '$CS_DIR/$MANIFEST_DIR' && s=\$SECONDS
    cargo $mode --profile dev ${args[*]:-} 2>&1 | grep -vE '^\s*(Compiling|Checking|Downloaded|Downloading|Updating|Blocking)' | tail -40
    echo \"rbuild-cs: cargo $mode \$((SECONDS-s)) s\""
  echo "rbuild-cs: sync $((t1 - t0)) s, total $(( $(date +%s) - t0 )) s"
  if [ "$fetch" = true ] && [ "$mode" = build ]; then
    OUT="$OUT" EXTRA=() ; local src="$CS_DIR/$MANIFEST_DIR/target/debug/$BIN"
    mkdir -p "$OUT"; local cfg; cfg="$(ssh_cfg)"; ssh -F "$cfg" "$(ssh_host "$cfg")" "base64 -w0 '$src'" 2>/dev/null | tr -d '\r\n' | base64 -d > "$OUT/$BIN.dev" && chmod +x "$OUT/$BIN.dev" && echo "rbuild-cs: dev binary -> $OUT/$BIN.dev"
  fi
}

cmd_clean() {
  remote "
    for d in /workspaces/*/target /workspaces/*/*/target; do
      [ -d \"\$d\" ] && { echo \"rbuild-cs: removing \$(du -sh \"\$d\" | cut -f1) \$d\"; rm -rf \"\$d\"; }
    done; df -h /workspaces | tail -1 | awk '{print \"rbuild-cs: \"\$4\" free\"}'"
}

cmd_down() {
  if [ "$(state)" = "Shutdown" ]; then echo "rbuild-cs: already stopped"; return; fi
  gh codespace stop -c "$CS"; echo "rbuild-cs: stopped $CS"
}

case "$VERB" in
  status) cmd_status ;;
  up)     cmd_up ;;
  build)  cmd_build ;;
  fetch)  cmd_fetch ;;
  run)    trap 'cmd_down' EXIT; cmd_build; cmd_fetch ;;
  sync)   cmd_sync ;;
  dev)    cmd_dev ;;
  sh)     if [ ${#EXTRA[@]} -gt 0 ]; then remote "${EXTRA[*]}"; else gh codespace ssh -c "$CS"; fi ;;
  clean)  cmd_clean ;;
  down)   cmd_down ;;
  -h|--help|help) usage 0 ;;
  *) echo "rbuild-cs: unknown verb $VERB" >&2; usage 2 ;;
esac
}

# exit here so bash never reads past this line: the file may have been
# edited while this process ran, and stale bytes would parse as garbage.
main "$@"; exit $?
